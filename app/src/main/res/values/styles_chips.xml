<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AmountChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_amount_chip</item>
        <item name="android:textColor">#0A0A0A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/pay_poppins_medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="RemarkChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_amount_chip</item>
        <item name="android:textColor">#0A0A0A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/pay_poppins_medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
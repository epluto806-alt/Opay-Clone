<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F4F4">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#F4F4F4"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBackReduce"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/chevron_right"
            android:rotation="180"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Reduce Balance"
            android:textColor="#0A0A0A"
            android:textSize="16sp"
            android:fontFamily="@font/pay_poppins_bold"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_radius_10"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Current Balance"
                    android:textColor="#8497A4"
                    android:textSize="12sp"
                    android:fontFamily="@font/pay_poppins_regular" />

                <TextView
                    android:id="@+id/tvReduceBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="₦0.00"
                    android:textColor="#0A0A0A"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/pay_poppins_bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_white_radius_10"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Amount to Remove"
                    android:textColor="#8497A4"
                    android:textSize="12sp"
                    android:fontFamily="@font/pay_poppins_regular" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₦"
                        android:textColor="#0A0A0A"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/pay_poppins_bold" />

                    <EditText
                        android:id="@+id/etReduceAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:hint="0.00"
                        android:textColor="#0A0A0A"
                        android:textColorHint="#B0B0B0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal"
                        android:fontFamily="@font/pay_poppins_bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:background="#EDEDED" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnReduceConfirm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_next_enabled"
                android:gravity="center"
                android:text="Remove Funds"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/pay_poppins_bold"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="This will deduct the amount from your available balance."
                android:textColor="#8497A4"
                android:textSize="11sp"
                android:fontFamily="@font/pay_poppins_regular" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
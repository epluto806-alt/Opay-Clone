<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="#0A0A0A"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Transfer to Bank Account"
            android:textColor="#0A0A0A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="@font/pay_poppins_bold" />
    </LinearLayout>

    <!-- RECIPIENT HEADER -->
    <LinearLayout
        android:id="@+id/recipientHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp">

            <ImageView
                android:id="@+id/ivBankLogo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/bank_default_icon"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRecipientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECIPIENT NAME"
                android:textColor="#0A0A0A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/pay_poppins_bold" />

            <TextView
                android:id="@+id/tvRecipientAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="000 000 0000"
                android:textColor="#8A8A8A"
                android:textSize="13sp"
                android:fontFamily="@font/pay_poppins_regular" />

            <TextView
                android:id="@+id/tvRecipientBank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Bank Name"
                android:textColor="#8A8A8A"
                android:textSize="12sp"
                android:fontFamily="@font/pay_poppins_regular" />
        </LinearLayout>
    </LinearLayout>

    <!-- AMOUNT CARD -->
    <LinearLayout
        android:id="@+id/amountCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:background="@drawable/bg_white_radius12"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/recipientHeader">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amount"
            android:textColor="#0A0A0A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/pay_poppins_bold" />

                <TextView
            android:id="@+id/tvTierPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#EDEDED"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text=""
            android:textColor="#0A0A0A"
            android:textSize="11sp"
            android:fontFamily="@font/pay_poppins_medium" />
<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8358;"
                android:textColor="#0A0A0A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/pay_poppins_bold" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="10.00 - 5,000,000.00"
                android:inputType="numberDecimal"
                android:textColor="#0A0A0A"
                android:textColorHint="#B0B0B0"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/pay_poppins_bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#F0F0F0" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stamp Duty"
                android:textColor="#8A8A8A"
                android:textSize="12sp"
                android:fontFamily="@font/pay_poppins_regular" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="&#9432;"
                android:textColor="#8A8A8A"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="" />

            <TextView
                android:id="@+id/tvStampDuty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8358;50.00"
                android:textColor="#0A0A0A"
                android:textSize="12sp"
                android:fontFamily="@font/pay_poppins_medium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip500"
                    style="@style/AmountChip"
                    android:text="&#8358;500" />

                <TextView
                    android:id="@+id/chip1000"
                    style="@style/AmountChip"
                    android:text="&#8358;1,000" />

                <TextView
                    android:id="@+id/chip2000"
                    style="@style/AmountChip"
                    android:text="&#8358;2,000" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip5000"
                    style="@style/AmountChip"
                    android:text="&#8358;5,000" />

                <TextView
                    android:id="@+id/chip9999"
                    style="@style/AmountChip"
                    android:text="&#8358;9,999" />

                <TextView
                    android:id="@+id/chip10000"
                    style="@style/AmountChip"
                    android:text="&#8358;10,000" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- REMARK CARD -->
    <LinearLayout
        android:id="@+id/remarkCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_white_radius12"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/amountCard">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remark"
            android:textColor="#0A0A0A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/pay_poppins_bold" />

        <EditText
            android:id="@+id/etRemark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@null"
            android:hint="What's this for? (Optional)"
            android:inputType="text"
            android:textColor="#0A0A0A"
            android:textColorHint="#B0B0B0"
            android:textSize="14sp"
            android:fontFamily="@font/pay_poppins_regular" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#F0F0F0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                    android:id="@+id/chipPurchase"
                    style="@style/RemarkChip"
                    android:text="Purchase" />

            <TextView
                    android:id="@+id/chipPersonal"
                    style="@style/RemarkChip"
                    android:text="Personal" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONFIRM -->
    <TextView
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="Confirm"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_green_pill"
        android:alpha="0.4"
        android:enabled="false"
        android:fontFamily="@font/pay_poppins_bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
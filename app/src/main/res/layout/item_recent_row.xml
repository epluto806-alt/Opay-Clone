<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipient Name"
            android:textColor="#0A0A0A"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/pay_poppins_medium" />

        <TextView
            android:id="@+id/tvRecentMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="0000000000 Bank"
            android:textColor="#6A6A6A"
            android:textSize="12sp"
            android:fontFamily="@font/pay_poppins_regular" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivRecentBadge"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/bank_default_icon"
        android:scaleType="centerCrop" />
</LinearLayout>
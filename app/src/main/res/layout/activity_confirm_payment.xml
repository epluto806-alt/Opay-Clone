<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="130dp"
        android:orientation="vertical"
        android:background="@drawable/bg_white_top_radius"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btnCloseConfirm"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close" />

        <TextView
            android:id="@+id/tvPayAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="&#8358;0.00"
            android:textColor="#0A0A0A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/pay_poppins_bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:background="@drawable/bg_white_radius12"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bank"
                    android:textColor="#8A8A8A"
                    android:textSize="13sp"
                    android:fontFamily="@font/pay_poppins_regular" />

                <ImageView
                    android:id="@+id/ivPayBankLogo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/bank_default_icon"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tvPayBank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#0A0A0A"
                    android:textSize="13sp"
                    android:fontFamily="@font/pay_poppins_medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Account Number"
                    android:textColor="#8A8A8A"
                    android:textSize="13sp"
                    android:fontFamily="@font/pay_poppins_regular" />

                <TextView
                    android:id="@+id/tvPayAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#0A0A0A"
                    android:textSize="13sp"
                    android:fontFamily="@font/pay_poppins_medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Name"
                    android:textColor="#8A8A8A"
                    android:textSize="13sp"
                    android:fontFamily="@font/pay_poppins_regular" />

                <TextView
                    android:id="@+id/tvPayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#0A0A0A"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/pay_poppins_medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Amount"
                    android:textColor="#8A8A8A"
                    android:textSize="13sp"
                    android:fontFamily="@font/pay_poppins_regular" />

                <TextView
                    android:id="@+id/tvPayTier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="#E7F8EF"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="Tens of Thousands"
                    android:textColor="#00B876"
                    android:textSize="11sp"
                    android:fontFamily="@font/pay_poppins_medium" />

                <TextView
                    android:id="@+id/tvPayAmountRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#0A0A0A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/pay_poppins_bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fee"
                    android:textColor="#8A8A8A"
                    android:textSize="13sp"
                    android:fontFamily="@font/pay_poppins_regular" />

                <TextView
                    android:id="@+id/tvPayFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#8358;0.00"
                    android:textColor="#0A0A0A"
                    android:textSize="13sp"
                    android:fontFamily="@font/pay_poppins_medium" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Payment Method"
                android:textColor="#5A5A5A"
                android:textSize="13sp"
                android:fontFamily="@font/pay_poppins_regular" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All >"
                android:textColor="#8A8A8A"
                android:textSize="13sp"
                android:fontFamily="@font/pay_poppins_regular" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_white_radius12"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bank_opay_round"
                    android:contentDescription="OPay" />

                <TextView
                    android:id="@+id/tvAvailableBalance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Available Balance (&#8358;0.00)"
                    android:textColor="#0A0A0A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/pay_poppins_bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvInsufficient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Insufficient balance"
                android:textColor="#C62828"
                android:textSize="12sp"
                android:fontFamily="@font/pay_poppins_regular" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#F0F0F0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWalletLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wallet (&#8358;0.00)"
                    android:textColor="#8A8A8A"
                    android:textSize="13sp"
                    android:fontFamily="@font/pay_poppins_regular" />

                <TextView
                    android:id="@+id/tvWalletRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Money >"
                    android:textColor="#00B876"
                    android:textSize="13sp"
                    android:fontFamily="@font/pay_poppins_medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OWealth (&#8358;4.57)"
                    android:textColor="#8A8A8A"
                    android:textSize="13sp"
                    android:fontFamily="@font/pay_poppins_regular" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_white_radius12"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#0A0A0A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/pay_poppins_bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Add a Bank Card / Account"
                android:textColor="#0A0A0A"
                android:textSize="13sp"
                android:fontFamily="@font/pay_poppins_medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_green_pill"
            android:gravity="center"
            android:text="Pay"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/pay_poppins_bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
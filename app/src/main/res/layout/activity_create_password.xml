<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/opay_white"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="16dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/opay_green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Create Password"
            android:textColor="@color/opay_text_primary"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="40dp"
            android:text="Create Password"
            android:textColor="@color/opay_text_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toBottomOf="@id/tvHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:text="Set up your 6-digit transaction password"
            android:textColor="@color/opay_text_secondary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvLabelPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="36dp"
            android:text="Enter password"
            android:textColor="@color/opay_text_primary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/passRow1"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvLabelPass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText android:id="@+id/p1" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
            <EditText android:id="@+id/p2" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
            <EditText android:id="@+id/p3" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
            <EditText android:id="@+id/p4" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
            <EditText android:id="@+id/p5" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
            <EditText android:id="@+id/p6" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLabelRePass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:text="Re-enter password"
            android:textColor="@color/opay_text_primary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/passRow1"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/passRow2"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvLabelRePass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText android:id="@+id/q1" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
            <EditText android:id="@+id/q2" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
            <EditText android:id="@+id/q3" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
            <EditText android:id="@+id/q4" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
            <EditText android:id="@+id/q5" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
            <EditText android:id="@+id/q6" style="@style/OtpBox" android:inputType="numberPassword" android:maxLength="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMismatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:text="Password mismatch. Please try again."
            android:textColor="#E53935"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/passRow2"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="32dp"
            android:text="Confirm"
            android:textAllCaps="false"
            android:textColor="@color/opay_white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/opay_green"
            app:cornerRadius="26dp"
            app:layout_constraintTop_toBottomOf="@id/tvMismatch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/fundTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnFundBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/opay_me_arrow_right"
            android:rotation="180"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Fund Account"
            android:textColor="#0A0A0A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/pay_poppins_bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/fundTopBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_radius_10"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Credit user by phone number"
                    android:textColor="#0A0A0A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/pay_poppins_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Only the creator should see this screen."
                    android:textColor="#8497A4"
                    android:textSize="11sp"
                    android:fontFamily="@font/pay_poppins_regular" />

                <EditText
                    android:id="@+id/etFundPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_outline"
                    android:hint="Phone number (10 digits)"
                    android:textColorHint="#9AA5AE"
                    android:textColor="#0A0A0A"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="number"
                    android:digits="0123456789"
                    android:maxLength="10"
                    android:fontFamily="@font/pay_poppins_regular"
                    android:importantForAutofill="no" />

                <EditText
                    android:id="@+id/etFundAmount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_outline"
                    android:hint="Amount to add (e.g. 5000)"
                    android:textColorHint="#9AA5AE"
                    android:textColor="#0A0A0A"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="numberDecimal"
                    android:fontFamily="@font/pay_poppins_regular"
                    android:importantForAutofill="no" />

                <TextView
                    android:id="@+id/btnFundAdd"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:background="@drawable/bg_next_enabled"
                    android:text="Add Funds"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/pay_poppins_bold" />

                <TextView
                    android:id="@+id/tvFundStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:textColor="#00B876"
                    android:textSize="12sp"
                    android:fontFamily="@font/pay_poppins_medium" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded_white"
    android:padding="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Transfer to"
            android:textColor="#0A0A0A"
            android:textSize="17sp"
            android:fontFamily="@font/pay_poppins_bold" />

        <ImageView
            android:id="@+id/btnCloseDialog"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close" />
    </FrameLayout>

    <ImageView
        android:id="@+id/ivDialogLogo"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:src="@drawable/bank_opay_round"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvDialogName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="RECIPIENT NAME"
        android:textColor="#0A0A0A"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="@font/pay_poppins_bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:background="@drawable/bg_gray_card_10"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Recipient Bank"
            android:textColor="#8497A4"
            android:textSize="12sp"
            android:fontFamily="@font/pay_poppins_regular" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/bank_opay_round" />

            <TextView
                android:id="@+id/tvDialogBank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="OPay"
                android:textColor="#0A0A0A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/pay_poppins_bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#E8E8E8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Account Number"
            android:textColor="#8497A4"
            android:textSize="12sp"
            android:fontFamily="@font/pay_poppins_regular" />

        <TextView
            android:id="@+id/tvDialogAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="000 000 0000"
            android:textColor="#0A0A0A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/pay_poppins_bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Kindly review the details before proceeding. Please note that successful transfers cannot be reversed."
        android:textColor="#4A5A63"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:fontFamily="@font/pay_poppins_regular" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRecheck"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="Recheck"
            android:textColor="#3BB776"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_light_green_pill"
            android:fontFamily="@font/pay_poppins_bold" />

        <TextView
            android:id="@+id/btnDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="Confirm"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_green_pill"
            android:fontFamily="@font/pay_poppins_bold" />
    </LinearLayout>

</LinearLayout>
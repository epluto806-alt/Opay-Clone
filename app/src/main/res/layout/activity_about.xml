<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F4F4">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="About"
            android:textColor="#0A0A0A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="@font/pay_poppins_bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="OPay Clone"
                android:textColor="#0A0A0A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/pay_poppins_bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Version 8.17.2.494"
                android:textColor="#8A8A8A"
                android:textSize="13sp"
                android:fontFamily="@font/pay_poppins_regular" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Kudos"
                android:textColor="#0A0A0A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/pay_poppins_bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Kudos to Peter Binary"
                android:textColor="#0A0A0A"
                android:textSize="14sp"
                android:fontFamily="@font/pay_poppins_regular" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kudos to Webtools"
                android:textColor="#0A0A0A"
                android:textSize="14sp"
                android:fontFamily="@font/pay_poppins_regular" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Network Topology Reference"
                android:textColor="#0A0A0A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/pay_poppins_bold" />

            <ImageView
                android:id="@+id/ivTopology"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:src="@drawable/about_topology"
                android:contentDescription="Topology diagram" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
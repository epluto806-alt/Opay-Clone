<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8FB"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/me_head_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E2F5EB"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="48dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_circle">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/opay_me_avatar_male" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMeGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hi, there"
                        android:textColor="#0A0A0A"
                        android:textSize="20sp"
                        android:fontFamily="@font/pay_poppins_bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_tier_pill"
                        android:paddingStart="4dp"
                        android:paddingEnd="10dp">

                        <TextView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_tip_icon"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:layout_gravity="center_vertical" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Upgrade to Tier 2"
                            android:textColor="#00B876"
                            android:textSize="11sp"
                            android:fontFamily="@font/pay_poppins_medium"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/opay_me_gear" />
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_red_dot_new" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Balance"
                    android:textColor="#0A0A0A"
                    android:textSize="14sp"
                    android:fontFamily="@font/pay_poppins_regular" />

                <ImageView
                    android:id="@+id/btnMeEye"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/opay_me_eye_show" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvMeBalance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="₦0.00"
                    android:textColor="#0A0A0A"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/pay_poppins_bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/opay_me_shield" />
            </LinearLayout>

            <!-- Interest Credited Today mint pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_interest_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interest Credited Today +₦0.09"
                    android:textColor="#00B876"
                    android:textSize="12sp"
                    android:fontFamily="@font/pay_poppins_medium"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/me_banner_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-29dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_safety_banner"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            app:layout_constraintTop_toBottomOf="@id/me_head_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 Safety Tips"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/pay_poppins_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Make your account more secure."
                    android:textColor="#E5FFF5"
                    android:textSize="12sp"
                    android:fontFamily="@font/pay_poppins_regular" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_white_pill"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center"
                android:text="View"
                android:textColor="#00B876"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/pay_poppins_bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/me_card_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_radius12"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/me_banner_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout style="@style/MERow" android:id="@+id/tileTxnHistory">
                <ImageView style="@style/MERowIcon" android:src="@drawable/opay_me_txn" />
                <TextView style="@style/MERowTitle" android:text="Transaction History" />
                <ImageView style="@style/MERowChevron" android:src="@drawable/opay_me_arrow_right" />
            </LinearLayout>
            <View style="@style/MEDivider" />

            <LinearLayout style="@style/MERow" android:id="@+id/tileAccountLimits">
                <ImageView style="@style/MERowIcon" android:src="@drawable/opay_me_limits" />
                <LinearLayout style="@style/MERowTextCol">
                    <TextView style="@style/MERowTitleInner" android:text="Account Limits" />
                    <TextView style="@style/MERowSubtitle" android:text="View your transaction limits" />
                </LinearLayout>
                <ImageView style="@style/MERowChevron" android:src="@drawable/opay_me_arrow_right" />
            </LinearLayout>
            <View style="@style/MEDivider" />

            <LinearLayout style="@style/MERow" android:id="@+id/tileBankCard">
                <ImageView style="@style/MERowIcon" android:src="@drawable/opay_me_bank_card" />
                <LinearLayout style="@style/MERowTextCol">
                    <TextView style="@style/MERowTitleInner" android:text="Bank Card/Account" />
                    <TextView style="@style/MERowSubtitle" android:text="Add payment option" />
                </LinearLayout>
                <ImageView style="@style/MERowChevron" android:src="@drawable/opay_me_arrow_right" />
            </LinearLayout>
            <View style="@style/MEDivider" />

            <LinearLayout style="@style/MERow" android:id="@+id/tilePayMe">
                <ImageView style="@style/MERowIcon" android:src="@drawable/opay_me_payme" />
                <LinearLayout style="@style/MERowTextCol">
                    <TextView style="@style/MERowTitleInner" android:text="Pay ME" />
                    <TextView style="@style/MERowSubtitle" android:text="Receive payment for your business" />
                </LinearLayout>
                <ImageView style="@style/MERowChevron" android:src="@drawable/opay_me_arrow_right" />
            </LinearLayout>
            <View style="@style/MEDivider" />

            <LinearLayout style="@style/MERow" android:id="@+id/tileOJunior">
                <ImageView style="@style/MERowIcon" android:src="@drawable/opay_me_ojunior" />
                <LinearLayout style="@style/MERowTextCol">
                    <TextView style="@style/MERowTitleInner" android:text="OJunior" />
                    <TextView style="@style/MERowSubtitle" android:text="Create an account for your child/ward" />
                </LinearLayout>
                <ImageView style="@style/MERowChevron" android:src="@drawable/opay_me_arrow_right" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/me_card_service"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_radius12"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/me_card_main"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout style="@style/MERow" android:id="@+id/tileSecurityCenter">
                <ImageView style="@style/MERowIcon" android:src="@drawable/opay_me_security" />
                <LinearLayout style="@style/MERowTextCol">
                    <TextView style="@style/MERowTitleInner" android:text="Security Center" />
                    <TextView style="@style/MERowSubtitle" android:text="Protect your funds" />
                </LinearLayout>
                <ImageView style="@style/MERowChevron" android:src="@drawable/opay_me_arrow_right" />
            </LinearLayout>
            <View style="@style/MEDivider" />

            <LinearLayout style="@style/MERow" android:id="@+id/tileCustomerService">
                <ImageView style="@style/MERowIcon" android:src="@drawable/opay_me_customer_service" />
                <TextView style="@style/MERowTitle" android:text="Customer Service Center" />
                <ImageView style="@style/MERowChevron" android:src="@drawable/opay_me_arrow_right" />
            </LinearLayout>
            <View style="@style/MEDivider" />

            <LinearLayout style="@style/MERow" android:id="@+id/tileInvitation">
                <ImageView style="@style/MERowIcon" android:src="@drawable/opay_me_invite" />
                <LinearLayout style="@style/MERowTextCol">
                    <TextView style="@style/MERowTitleInner" android:text="Invitation" />
                    <TextView style="@style/MERowSubtitle" android:text="Invite friends and earn up to ₦5,600 Bonus" />
                </LinearLayout>
                <ImageView style="@style/MERowChevron" android:src="@drawable/opay_me_arrow_right" />
            </LinearLayout>
            <View style="@style/MEDivider" />

            <LinearLayout style="@style/MERow" android:id="@+id/tileUssd">
                <ImageView style="@style/MERowIcon" android:src="@drawable/opay_me_ussd" />
                <TextView style="@style/MERowTitle" android:text="OPay USSD" />
                <ImageView style="@style/MERowChevron" android:src="@drawable/opay_me_arrow_right" />
            </LinearLayout>
            <View style="@style/MEDivider" />

            <LinearLayout style="@style/MERow" android:id="@+id/tileRateUs">
                <ImageView style="@style/MERowIcon" android:src="@drawable/opay_me_rate" />
                <TextView style="@style/MERowTitle" android:text="Rate Us" />
                <ImageView style="@style/MERowChevron" android:src="@drawable/opay_me_arrow_right" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>







